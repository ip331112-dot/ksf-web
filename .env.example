# KSF Tech Services — required environment variables.
# COMMITTED ON PURPOSE: documents the full set with no real values.
# Copy to .env.local and fill in. Never put real values in this file.

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# --- Supabase -----------------------------------------------------------
# Browser-safe; guarded by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Direct Postgres connection, used ONLY by scripts/migrate.mjs to apply
# migrations. Dashboard → Project Settings → Database → Connection string
# (Session pooler or Direct). Not read by the app at runtime.
#
# This exists because pasting migrations into the dashboard's SQL Editor
# proved unreliable — large pastes silently fail to land, and the editor
# has been observed prepending stray keystrokes to the SQL.
DATABASE_URL=

# SERVER ONLY — bypasses all RLS. Never expose to the browser.
# Also the switch for the enquiry forms: while this is empty, /contact and
# the service pages show "not live yet" instead of accepting a message
# they could not store. Those pages are statically rendered, so setting it
# takes effect on the next build, not on the next request.
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte hex salt for hashing enquiry IPs (rate limiting only).
LEAD_IP_SALT=

# --- Resend -------------------------------------------------------------
# Without RESEND_API_KEY and EMAIL_FROM the site sends nothing at all and
# says so honestly: the apply success page tells the applicant their
# status link exists only on that page, and the admin decision panel
# warns staff that the applicant was NOT emailed. Nothing breaks; people
# just have to be told by hand.
#
# EMAIL_FROM must be on a domain verified in Resend, or every send is
# rejected. For testing before the domain is verified, Resend allows
# onboarding@resend.dev as the sender.
RESEND_API_KEY=
EMAIL_FROM=
# Where staff alerts go. Defaults to SITE.email if unset.
EMAIL_ALERT_TO=

# --- Cloudflare Turnstile ----------------------------------------------
# Without these, a PRODUCTION build refuses every enquiry — deliberately,
# so bot protection can never be lost by accident. Development is
# unaffected. Verified 2026-08-27 by running a production build with them
# empty: every submission failed.
#
# Real keys come from dash.cloudflare.com > Turnstile > Add site. Add both
# ksftechservices.com and localhost to the site's domain list, or the
# widget refuses to render while developing.
#
# Cloudflare also publishes dummy keys that work on ANY domain, so the
# whole path can be exercised without an account. Verified 2026-09-02:
# the widget rendered, issued "XXXX.DUMMY.TOKEN.XXXX", and the always-
# fails secret made the server surface "That check did not pass" without
# writing a lead — which is what proves the token actually reaches
# Cloudflare rather than being waved through.
#
#   site   1x00000000000000000000AA            always passes, visible
#   site   2x00000000000000000000AB            always blocks, visible
#   site   3x00000000000000000000FF            forces an interactive challenge
#   secret 1x0000000000000000000000000000000AA always passes
#   secret 2x0000000000000000000000000000000AA always fails
#
# NEVER deploy the test keys. They accept every token, so production would
# have a Turnstile widget on screen and no bot protection behind it —
# strictly worse than ENQUIRIES_WITHOUT_TURNSTILE, which at least says so
# in the logs.
#
# Check any environment file before trusting it:
#
#   node scripts/verify-turnstile.mjs
#   node scripts/verify-turnstile.mjs --file .env.production
#
# It asks Cloudflare whether the secret is real, refuses test keys in a
# production file, and exits non-zero on anything that would leave the
# site unprotected — so it can gate a deploy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Escape hatch: set to "true" to accept enquiries in production WITHOUT a
# Turnstile challenge. The honeypot and the 3-per-10-minutes rate limit
# still apply, but bots that execute JavaScript will get through. Use it
# to launch before the Cloudflare account exists, then remove it.
ENQUIRIES_WITHOUT_TURNSTILE=

# --- Shop: bank transfer ------------------------------------------------
# The shop invoices by bank transfer. Until BANK_ACCOUNT_NAME and either
# a sort code or an IBAN are set, the invoice email says plainly that
# details are coming rather than pretending it can be paid — an order is
# still recorded, it just cannot be settled yet.
#
# Sort code and account number are what a UK buyer needs; IBAN and BIC
# are what a French one needs. Set both pairs if you sell to both.
BANK_ACCOUNT_NAME=
BANK_SORT_CODE=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=
BANK_BIC=

# --- Stripe -------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
