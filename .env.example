# KSF Tech Services — required environment variables.
# COMMITTED ON PURPOSE: documents the full set with no real values.
# Copy to .env.local and fill in. Never put real values in this file.

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# --- Supabase -----------------------------------------------------------
# Browser-safe; guarded by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY — bypasses all RLS. Never expose to the browser.
# Also the switch for the enquiry forms: while this is empty, /contact and
# the service pages show "not live yet" instead of accepting a message
# they could not store. Those pages are statically rendered, so setting it
# takes effect on the next build, not on the next request.
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte hex salt for hashing enquiry IPs (rate limiting only).
LEAD_IP_SALT=

# --- Resend -------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_ALERT_TO=

# --- Cloudflare Turnstile ----------------------------------------------
# Without these, a PRODUCTION build refuses every enquiry — deliberately,
# so bot protection can never be lost by accident. Development is
# unaffected. Verified 2026-08-27 by running a production build with them
# empty: every submission failed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Escape hatch: set to "true" to accept enquiries in production WITHOUT a
# Turnstile challenge. The honeypot and the 3-per-10-minutes rate limit
# still apply, but bots that execute JavaScript will get through. Use it
# to launch before the Cloudflare account exists, then remove it.
ENQUIRIES_WITHOUT_TURNSTILE=

# --- Stripe -------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
